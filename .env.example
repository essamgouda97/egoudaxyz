PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=
SITE_URL=http://127.0.0.1:5173

# Services intake chat
DEEPSEEK_API_KEY=
# Optional test override. Leave empty in production.
DEEPSEEK_API_URL=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_MS=30000

# Set to mock for deterministic testing without model calls.
SERVICES_CHAT_MODE=
SERVICES_CHAT_RATE_LIMIT=30
SERVICES_TOOL_TIMEOUT_MS=12000

# Optional web tools for the services intake agent.
# Cloudflare Browser Run uses CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID.
# Optional test override. Leave empty in production.
CLOUDFLARE_BROWSER_MARKDOWN_API_URL=
# Optional public web search provider. Leave empty to disable general search.
BRAVE_SEARCH_API_KEY=
SERVICES_WEB_SEARCH_API_URL=
SERVICES_WEB_SEARCH_API_KEY=

# Services intake report email
# Cloudflare Email Service. CF_* names are also accepted by the app.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_WORKER_URL=
CLOUDFLARE_EMAIL_WORKER_SECRET=
# Optional test override. Leave empty in production.
CLOUDFLARE_EMAIL_API_URL=
CLOUDFLARE_EMAIL_TIMEOUT_MS=20000
# Defaults to me@egouda.xyz when empty.
REPORT_EMAIL_FROM=me@egouda.xyz
REPORT_EMAIL_TO=me@egouda.xyz

# Set to mock for deterministic local testing of the sent-email UI.
REPORT_EMAIL_MODE=
SERVICES_PACKAGE_RATE_LIMIT=8
