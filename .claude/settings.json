{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(npm run check:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)",
      "Bash(npx svelte-check:*)",
      "Bash(uv sync:*)",
      "Bash(uv run python:*)",
      "Bash(uv pip:*)",
      "Bash(make:*)",
      "Bash(psql:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "WebSearch",
      "WebFetch",
      "Agent",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TeamCreate",
      "SendMessage",
      "NotebookEdit"
    ],
    "deny": [
      "Bash(make db-clear:*)",
      "Bash(make db-reset:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
